{
  "random_state": 42,
  "variants": ["baseline", "with_macro"],
  "data": {
    "symbol": "EURUSD",
    "timeframe": "D1",
    "history_csv_path": "results/eurusd_features.csv",
    "live_symbol": "EURUSD=X",
    "live_fetch_bars": 250
  },
  "macro": {
    "fred_series": {
      "us10y": "DGS10",
      "de10y": "IRLTLT01DEM156N"
    },
    "cache_path": "results/yield_differential.csv",
    "features": {
      "usd_index": {
        "series": { "usd_index": "DTWEXBGS" },
        "cache_path": "results/usd_index.csv"
      },
      "policy_rate": {
        "series": { "fed": "DFF", "ecb": "ECBDFR" },
        "cache_path": "results/policy_rate_differential.csv"
      },
      "inflation": {
        "series": { "us_cpi": "CPIAUCSL", "de_cpi": "CP0000DEM086NEST" },
        "cache_path": "results/inflation_differential.csv",
        "yoy_lookback_days": 420
      }
    }
  },
  "tracking": {
    "log_path": "results/prediction_log.csv",
    "html_path": "results/prediction_history.html"
  },
  "paper_trading": {
    "spread_pips": 1.5,
    "ledgers": {
      "baseline": {
        "direction_column": "baseline_direction",
        "log_path": "results/paper_trading_log_baseline.csv"
      },
      "with_macro": {
        "direction_column": "pred_direction",
        "log_path": "results/paper_trading_log_macro.csv"
      }
    }
  },
  "pca": {
    "variance_threshold": 0.95,
    "lag_columns": [
      "return_lag_1", "dynamics_lag_1",
      "return_lag_2", "dynamics_lag_2",
      "return_lag_3", "dynamics_lag_3"
    ]
  },
  "split": {
    "train_fraction": 0.80,
    "val_fraction": 0.10
  },
  "gbm": {
    "cv_splits": 5,
    "param_grid": {
      "n_estimators": [100, 200],
      "learning_rate": [0.01, 0.05, 0.1],
      "max_depth": [3, 5],
      "subsample": [0.5, 0.8, 1.0]
    },
    "huber_alpha": 0.9
  },
  "h1": {
    "cache_path": "results/eurusd_h1.csv",
    "cv_splits": 5,
    "rf_param_grid": {
      "n_estimators": [200, 400],
      "max_depth": [4, 8, null]
    },
    "svm_param_grid": {
      "C": [0.1, 1.0, 10.0],
      "gamma": ["scale", 0.1]
    },
    "lstm_units": 32,
    "lstm_dropout": 0.2,
    "lstm_lr": 0.001,
    "lstm_epochs": 60,
    "lstm_batch": 32,
    "lstm_patience": 8
  },
  "lstm": {
    "time_steps": 20,
    "units": 64,
    "dropout": 0.3,
    "learning_rate": 0.001,
    "epochs": 100,
    "batch_size": 64,
    "patience": 10,
    "loss_weights": {
      "return_output": 1.0,
      "direction_output": 1.0
    }
  }
}
